# App
CHAINWISE_ENVIRONMENT=local
CHAINWISE_LOG_LEVEL=INFO
CHAINWISE_NETWORK=ethereum-mainnet

# Agent (LangGraph checkpoints)
CHAINWISE_DATABASE_URL=postgresql://chainwise:chainwise@localhost:5432/chainwise

# LLM (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-nano

# Repo grounding (GitHub code search). Optional: without it, code search is
# unauthenticated and GitHub's API rejects it (401), so grounding always
# degrades to "no match" — the app still works, it just skips this fallback.
GITHUB_TOKEN=
